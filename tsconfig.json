{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES2015",
    "outDir": "./public/dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./src/**/*.ts"                          
  ],
  "exclude": [
    "node_modules"                            
  ]
}